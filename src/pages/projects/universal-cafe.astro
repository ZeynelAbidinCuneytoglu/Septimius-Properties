---
// projects/universal-cafe.astro - Universal Café project detail page
import BaseLayout from '../../layouts/BaseLayout.astro';

const projectImages = [
  '/Images/Universal Cafe/Universal Cafe - Septimius Pro.-1.jpg',
  '/Images/Universal Cafe/Universal Cafe - Septimius Pro.-2.jpg',
  '/Images/Universal Cafe/Universal Cafe - Septimius Pro.-3.jpg',
  '/Images/Universal Cafe/Universal Cafe - Septimius Pro.-4.jpg',
  '/Images/Universal Cafe/Universal Cafe - Septimius Pro.-5.jpg',
  '/Images/Universal Cafe/Universal Cafe - Septimius Pro.-6.jpg'
];
---

<BaseLayout title="Universal Café – Dublin" description="Modern café design featuring contemporary furniture, custom fitout solutions, and innovative interior design in the heart of Dublin.">
  
  <!-- Full-Width Hero Section -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gray-900">
      <img 
        src={projectImages[0]} 
        alt="Universal Café – Dublin" 
        class="w-full h-full object-cover opacity-80"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
    </div>
    
    <div class="relative z-10 container mx-auto px-4 pb-12">
      <nav class="text-white text-sm mb-4">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/projects" class="hover:text-amber-400 transition-colors">Projects</a>
        <span class="mx-2">/</span>
        <span class="text-amber-400">Universal Café</span>
      </nav>
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-2">Universal Café</h1>
      <p class="text-xl text-white/90">Design, Fitout, Furniture</p>
    </div>
  </section>

  <!-- Project Details Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">Project Overview</h2>
          
          <div class="prose prose-lg max-w-none mb-8">
            <p class="text-gray-700 leading-relaxed mb-4">
              Universal Café represents a complete transformation of a traditional Dublin café space into a modern, vibrant destination that seamlessly blends contemporary design with functional elegance.
            </p>
            <p class="text-gray-700 leading-relaxed mb-4">
              Our team delivered a comprehensive design solution that encompassed interior design, custom fitout, and furniture selection. The project required careful consideration of both aesthetics and operational requirements, creating a space that is both visually stunning and highly practical for daily café operations.
            </p>
            <p class="text-gray-700 leading-relaxed">
              The design features custom-built furniture pieces, carefully selected materials that combine durability with style, and an innovative lighting scheme that enhances the café's atmosphere throughout the day.
            </p>
          </div>

          <!-- Project Images Gallery -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
            {projectImages.slice(1).map((image, index) => (
              <div class="relative overflow-hidden rounded-lg shadow-lg group">
                <img 
                  src={image} 
                  alt={`Universal Café - Image ${index + 2}`} 
                  class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500"
                />
              </div>
            ))}
          </div>
        </div>

        <!-- Sidebar - Project Info -->
        <div class="lg:col-span-1">
          <div class="bg-gray-50 p-8 rounded-lg sticky top-24">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">Project Details</h3>
            
            <div class="space-y-6">
              <div>
                <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Location</h4>
                <p class="text-gray-900 font-medium">Dublin, Ireland</p>
              </div>
              
              <div>
                <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Services</h4>
                <ul class="space-y-2">
                  <li class="text-gray-900">Interior Design</li>
                  <li class="text-gray-900">Custom Fitout</li>
                  <li class="text-gray-900">Furniture Selection</li>
                  <li class="text-gray-900">Lighting Design</li>
                </ul>
              </div>
              
              <div>
                <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Year</h4>
                <p class="text-gray-900 font-medium">2024</p>
              </div>
              
              <div>
                <h4 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Status</h4>
                <p class="text-amber-500 font-medium">Completed</p>
              </div>
            </div>

            <a 
              href="/contact" 
              class="mt-8 inline-block w-full bg-amber-500 text-white text-center font-semibold py-3 px-6 rounded-lg hover:bg-amber-600 transition-colors duration-300 uppercase tracking-wide"
            >
              Discuss Your Project
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Projects -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-12 text-center">Related Projects</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <a href="/projects/sheelin-lakehouse" class="group">
          <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300">
            <img 
              src="/Images/Lakehouse Property/DJI_0346.JPG" 
              alt="Sheelin Lakehouse" 
              class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-amber-500 transition-colors">Sheelin Lakehouse</h3>
              <p class="text-gray-600">Design, Renovate, Furniture, Rental</p>
            </div>
          </div>
        </a>
        
        <a href="/projects/wicklow-holiday-home" class="group">
          <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300">
            <img 
              src="/Images/Wicklow House/WicklowHouse-1.png" 
              alt="Wicklow Holiday Home" 
              class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-amber-500 transition-colors">Wicklow Holiday Home</h3>
              <p class="text-gray-600">Architectural Design</p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>