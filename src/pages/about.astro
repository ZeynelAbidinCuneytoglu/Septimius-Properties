---
// about.astro - About Us page with enhanced design
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us" description="Learn about Septimius Properties - delivering high-quality construction, bespoke architectural solutions, and premium rental properties.">
  
  <!-- Hero Section with Image Overlay -->
  <section class="relative h-96 md:h-[600px] flex items-center justify-center">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 bg-gray-900">
      <img 
        src="/Images/Wicklow House/wicklow-02.png" 
        alt="Interior design background" 
        class="w-full h-full object-cover opacity-60"
      />
      <div class="absolute inset-0 bg-black bg-opacity-40"></div>
    </div>
    
    <!-- Hero Content -->
    <div class="relative z-10 text-center text-white animate-fade-in-up">
      <h1 class="text-5xl md:text-7xl font-bold mb-4">We Are Septimius Properties</h1>
      <nav class="text-sm md:text-base mt-4">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-amber-400">ABOUT</span>
      </nav>
    </div>
  </section>

  <!-- Main About Section - Team Photo and Description -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Team Photo on Left -->
        <div class="order-2 lg:order-1 relative">
          <img 
            src="/Images/Architect office images/office-01.jpg" 
            alt="Septimius Properties team" 
            class="w-full rounded-lg shadow-xl relative z-10"
          />
          <!-- Decorative Elements -->
          <div class="absolute -bottom-6 -right-6 w-full h-full bg-amber-100 rounded-lg -z-0"></div>
          <div class="absolute -top-6 -left-6 w-2/3 h-2/3 border-2 border-amber-500 rounded-lg -z-0"></div>
        </div>

        <!-- Company Description on Right -->
        <div class="order-1 lg:order-2">
          <span class="text-amber-500 text-sm uppercase tracking-[0.3em] mb-4 block">About Us</span>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            We are Septimius Properties
          </h2>
          <div class="w-24 h-1 bg-amber-500 mb-8"></div>
          
          <div class="space-y-6 text-gray-600 leading-relaxed">
            <p class="text-lg">
              Septimius Properties is a Dublin-based company specialising in architecture, interiors and furniture, property management and premium rentals.
            </p>
           
           
          </div>

          <!-- Key Points -->
          <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex items-start space-x-3">
              <svg class="w-6 h-6 text-amber-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">Qualified Professionals</span>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-6 h-6 text-amber-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">End-to-End Solutions</span>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-6 h-6 text-amber-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">Sustainable Practices</span>
            </div>
            <div class="flex items-start space-x-3">
              <svg class="w-6 h-6 text-amber-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">Client-Focused Approach</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

 
  <!-- Our Team Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <span class="text-amber-500 text-sm uppercase tracking-[0.3em] mb-4 block">Meet The Team</span>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Our Team</h2>
        <div class="w-24 h-1 bg-amber-500 mx-auto mb-8"></div>
        <p class="text-gray-600 max-w-2xl mx-auto text-lg">
          Meet the talented professionals behind Septimius Properties. Our diverse team brings together expertise in architecture, interior design, project management, and customer service to deliver exceptional results.
        </p>
      </div>

      <!-- Team Members Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
        <!-- Team Member 1 -->
        <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 group">
          <div class="relative overflow-hidden">
            <img 
              src="/Images/avatar-placeholder.jpg" 
              alt="Abdullah Duibi - CEO" 
              class="w-full h-80 object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
          <div class="p-6 text-center">
            <h3 class="text-xl font-bold text-gray-900 mb-2">Abdullah Duibi</h3>
            <p class="text-amber-500 font-semibold mb-4">Founder &amp; CEO</p>
            <div class="flex justify-center space-x-3">
             
              <a href="mailto:ceo@septimiusproperties.com" class="w-10 h-10 border-2 border-gray-300 rounded-full flex items-center justify-center hover:border-amber-500 hover:text-amber-500 hover:scale-110 transition-all duration-300" aria-label="Email">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Team Member 2 -->
        <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 group">
          <div class="relative overflow-hidden">
            <img 
              src="/Images/Team Photos/Radwan.jpeg"
              alt="Radwan Bazama - General Manager" 
              class="w-full h-80 object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
          <div class="p-6 text-center">
            <h3 class="text-xl font-bold text-gray-900 mb-2">Radwan Bazama</h3>
            <p class="text-amber-500 font-semibold mb-4">General Manager</p>
            <div class="flex justify-center space-x-3">           
              <a href="mailto:gm@septimiusproperties.com" class="w-10 h-10 border-2 border-gray-300 rounded-full flex items-center justify-center hover:border-amber-500 hover:text-amber-500 hover:scale-110 transition-all duration-300" aria-label="Email">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Team Member 3 -->
        <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 group">
          <div class="relative overflow-hidden">
            <img 
              src="/Images/Team Photos/Riyadh.jpeg"
              alt="Riyad Simon - Project Manager" 
              class="w-full h-80 object-cover group-hover:scale-110 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
          <div class="p-6 text-center">
            <h3 class="text-xl font-bold text-gray-900 mb-2">Riyad Simon</h3>
            <p class="text-amber-500 font-semibold mb-4">Project Manager</p>
            <div class="flex justify-center space-x-3">
              <a href="mailto:riyad@septimiusproperties.com" class="w-10 h-10 border-2 border-gray-300 rounded-full flex items-center justify-center hover:border-amber-500 hover:text-amber-500 hover:scale-110 transition-all duration-300" aria-label="Email">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-white relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,255,255,0.1) 10px, rgba(255,255,255,0.1) 20px);"></div>
    </div>
    
    <div class="container mx-auto px-4 text-center relative z-10">
      <span class="text-amber-400 text-sm uppercase tracking-[0.3em] mb-4 block">Join Us</span>
      <h2 class="text-3xl md:text-5xl font-bold mb-6">Ready to Work Together?</h2>
      <p class="text-lg md:text-xl mb-10 max-w-2xl mx-auto text-gray-300">
        Let's bring your vision to life. Contact us today to discuss your next project.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="group relative inline-flex items-center justify-center px-8 py-4 overflow-hidden font-medium transition duration-300 ease-out border-2 border-amber-500 rounded-lg shadow-md text-lg">
          <span class="absolute inset-0 flex items-center justify-center w-full h-full text-white duration-300 -translate-x-full bg-amber-500 group-hover:translate-x-0 ease">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </span>
          <span class="absolute flex items-center justify-center w-full h-full text-amber-500 transition-all duration-300 transform group-hover:translate-x-full ease">Get in Touch</span>
          <span class="relative invisible">Get in Touch</span>
        </a>
        <a href="/projects" class="inline-block px-8 py-4 border-2 border-white text-white rounded-lg font-semibold hover:bg-white hover:text-gray-900 transition-colors duration-300 text-lg">
          View Our Work
        </a>
      </div>
    </div>
  </section>

  <!-- Counter Animation Script -->
  <script>
    // Counter animation
    const animateCounter = (element) => {
      const target = parseInt(element.getAttribute('data-target'));
      const duration = 2000;
      const steps = 60;
      const increment = target / steps;
      let current = 0;

      const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
          element.textContent = target + '+';
          clearInterval(timer);
        } else {
          element.textContent = Math.floor(current);
        }
      }, duration / steps);
    };

    // Intersection Observer for counter animation
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    // Observe all counter elements
    document.querySelectorAll('.count-up').forEach(counter => {
      observer.observe(counter);
    });
  </script>

  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in-up {
      animation: fadeInUp 1s ease-out;
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.5;
      }
    }

    .animate-pulse {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
  </style>
</BaseLayout>