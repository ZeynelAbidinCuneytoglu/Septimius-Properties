---
// services/index.astro - Services page with alternating image/text layout
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Our Services" description="Discover Septimius Properties' comprehensive range of services including interior design, architecture, holiday rentals, and premium furniture.">
  
  <!-- Hero Section with Image Overlay -->
  <section class="relative h-96 md:h-[500px] flex items-center justify-center">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 bg-gray-900">
      <img 
        src="/Images/Universal Cafe/Universal Cafe - Septimius Pro.-2.jpg" 
        alt="Services background" 
        class="w-full h-full object-cover opacity-60"
      />
      <div class="absolute inset-0 bg-black bg-opacity-50"></div>
    </div>
    
    <!-- Hero Content -->
    <div class="relative z-10 text-center text-white">
      <h1 class="text-5xl md:text-7xl font-bold mb-4">We Are Septimius Properties</h1>
      <nav class="text-sm md:text-base mt-4">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-amber-400">SERVICE</span>
      </nav>
    </div>
  </section>

  <!-- Services Showcase Section with Alternating Layout -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4">
      
      <!-- Service 1: Architecture & Interior Design (Text Left, Image Right) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center mb-20 md:mb-32">
        <div class="order-2 md:order-1">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Architecture & Interior Design</h2>
          <p class="text-lg md:text-xl text-gray-700 mb-4 leading-relaxed">
            Our integrated approach combines architectural precision with interior creativity. From initial concept to final fitout, we create stunning, functional environments that inspire and endure.
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            Whether you need a complete architectural build or a transformative interior fitout, our team of qualified architects and registered interior designers combines creativity with technical rigour to deliver extraordinary results.
          </p>
          <a 
            href="/services/architecture-and-interiors" 
            class="inline-block bg-amber-500 text-white font-semibold py-3 px-8 hover:bg-amber-600 transition-colors duration-300 uppercase"
          >
            READ MORE
          </a>
        </div>
        <div class="order-1 md:order-2">
          <img 
            src="Images/Architect office images/Architecture-1.jpeg" 
            alt="Architecture and Interior Design" 
            class="w-full h-auto rounded-lg shadow-lg"
          />
        </div>
      </div>

      <!-- Service 2: Holiday Rentals (Image Left, Text Right) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center mb-20 md:mb-32">
        <div class="order-1 md:order-1">
          <img 
            src="/Images/Lakehouse Property/lake house-01.jpg" 
            alt="Holiday Rentals" 
            class="w-full h-auto rounded-lg shadow-lg"
          />
        </div>
        <div class="order-2 md:order-2">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Holiday Rentals</h2>
          <p class="text-lg md:text-xl text-gray-700 mb-4 leading-relaxed">
            Experience comfort and style with our premium holiday rental properties. Each property is carefully selected and maintained to the highest standards.
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            Our portfolio includes beautifully designed spaces equipped with modern amenities, high-quality furnishings, and thoughtful touches that ensure a memorable stay. Whether you're planning a weekend getaway or an extended vacation, our holiday rentals provide the perfect base for exploring Ireland's stunning landscapes.
          </p>
          <a 
            href="/services/holiday-rentals" 
            class="inline-block bg-amber-500 text-white font-semibold py-3 px-8 hover:bg-amber-600 transition-colors duration-300 uppercase"
          >
            READ MORE
          </a>
        </div>
      </div>

      <!-- Service 3: Premium Furniture (Text Left, Image Right) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
        <div class="order-2 md:order-1">
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Premium Furniture</h2>
          <p class="text-lg md:text-xl text-gray-700 mb-4 leading-relaxed">
            Elevate your interior spaces with our curated selection of premium furniture and accessories from trusted manufacturers and designers.
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            We offer both contemporary and classic styles to suit any aesthetic. Our furniture services include space-specific recommendations, custom procurement, delivery, and installation. From statement pieces to complete room furnishings, we help you create cohesive, stylish interiors.
          </p>
          <a 
            href="/services/premium-furniture" 
            class="inline-block bg-amber-500 text-white font-semibold py-3 px-8 hover:bg-amber-600 transition-colors duration-300 uppercase"
          >
            READ MORE
          </a>
        </div>
        <div class="order-1 md:order-2">
          <img 
            src="/Images/Universal Cafe/Universal Cafe - Septimius Pro.-4.jpg" 
            alt="Premium Furniture" 
            class="w-full h-auto rounded-lg shadow-lg"
          />
        </div>
      </div>

    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-gray-900 mb-6">Why Choose Septimius Properties</h2>
        <div class="w-24 h-1 bg-amber-500 mx-auto mb-8"></div>
        <p class="text-gray-600 text-lg max-w-3xl mx-auto">
          We combine expertise, creativity, and attention to detail to deliver exceptional results across all our services.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Feature 1 -->
        <div class="bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 text-center group">
          <div class="w-16 h-16 bg-amber-500/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-amber-500 transition-colors">
            <svg class="w-8 h-8 text-amber-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Expert Team</h3>
          <p class="text-gray-600">Qualified and registered professionals with years of industry experience.</p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 text-center group">
          <div class="w-16 h-16 bg-amber-500/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-amber-500 transition-colors">
            <svg class="w-8 h-8 text-amber-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Custom Solutions</h3>
          <p class="text-gray-600">Tailored designs and services that perfectly match your unique vision and needs.</p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 text-center group">
          <div class="w-16 h-16 bg-amber-500/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-amber-500 transition-colors">
            <svg class="w-8 h-8 text-amber-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">On-Time Delivery</h3>
          <p class="text-gray-600">We respect your time and ensure projects are completed within agreed timelines.</p>
        </div>

        <!-- Feature 4 -->
        <div class="bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 text-center group">
          <div class="w-16 h-16 bg-amber-500/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-amber-500 transition-colors">
            <svg class="w-8 h-8 text-amber-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Quality First</h3>
          <p class="text-gray-600">Uncompromising commitment to excellence in every aspect of our work.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-white relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,255,255,0.1) 10px, rgba(255,255,255,0.1) 20px);"></div>
    </div>
    
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <span class="text-amber-400 text-sm uppercase tracking-[0.3em] mb-4 block">Let's Work Together</span>
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Ready to Start Your Project?</h2>
        <p class="text-lg md:text-xl mb-10 text-gray-300 max-w-2xl mx-auto">
          Whether you need interior design, architecture, holiday rentals, or premium furniture, our expert team is ready to bring your vision to life.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="group relative inline-flex items-center justify-center px-8 py-4 overflow-hidden font-medium transition duration-300 ease-out border-2 border-amber-500 rounded-lg shadow-md text-lg">
            <span class="absolute inset-0 flex items-center justify-center w-full h-full text-white duration-300 -translate-x-full bg-amber-500 group-hover:translate-x-0 ease">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </span>
            <span class="absolute flex items-center justify-center w-full h-full text-amber-500 transition-all duration-300 transform group-hover:translate-x-full ease">Get in Touch</span>
            <span class="relative invisible">Get in Touch</span>
          </a>
          <a href="/projects" class="inline-block px-8 py-4 border-2 border-white text-white rounded-lg font-semibold hover:bg-white hover:text-gray-900 transition-colors duration-300 text-lg">
            View Our Work
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
    </div>
  </section>
</BaseLayout>