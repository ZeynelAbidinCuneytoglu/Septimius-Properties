---
// Footer.astro - Detailed professional footer
---

<footer class="bg-gray-900 text-gray-300">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Company Info -->
      <div class="space-y-4">
        <h3 class="text-2xl font-bold text-white mb-4">Septimius Properties</h3>
        <p class="text-sm leading-relaxed">
          Innovative designs, premium rental properties, and unparalleled client service.
        </p>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="text-white font-semibold text-lg mb-4">Quick Links</h4>
        <ul class="space-y-2">
          <li>
            <a href="/" class="hover:text-white transition-colors duration-300 text-sm">Home</a>
          </li>
          <li>
            <a href="/about" class="hover:text-white transition-colors duration-300 text-sm">About Us</a>
          </li>
          <li>
            <a href="/services" class="hover:text-white transition-colors duration-300 text-sm">Services</a>
          </li>
          <li>
            <a href="/projects" class="hover:text-white transition-colors duration-300 text-sm">Projects</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-white transition-colors duration-300 text-sm">Contact Us</a>
          </li>
        </ul>
      </div>

      <!-- Contact Information -->
      <div>
        <h4 class="text-white font-semibold text-lg mb-4">Contact Us</h4>
        <div class="space-y-3 text-sm">
          <div class="flex items-start">
            <svg class="w-5 h-5 text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <p>Landscape House, Baldonnell Business Park, Citywest, Dublin 22.</p>
          </div>
          <div class="flex items-center">
            <svg class="w-5 h-5 text-blue-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <a href="tel:+35319636050" class="hover:text-white transition-colors duration-300">+353 1 963 6050</a>
          </div>
          <div class="flex items-center">
            <svg class="w-5 h-5 text-blue-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href="mailto:info@septimiusproperties.com" class="hover:text-white transition-colors duration-300">info@septimiusproperties.com</a>
          </div>
        </div>
      </div>

      <!-- Social Media -->
      <div>
        <h4 class="text-white font-semibold text-lg mb-4">Follow Us</h4>
        <div class="flex space-x-4">
          <a
            href="https://www.instagram.com/septimiusproperties/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-blue-600 transition-colors duration-300"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-800 mt-8 pt-8 text-center text-sm">
      <p>&copy; {new Date().getFullYear()} Septimius Properties. All rights reserved.</p>
    </div>
  </div>
</footer>
