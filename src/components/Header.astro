---
// Header.astro - Navigation header component
---

<!-- Top Bar (Not Sticky) -->
<div id="top-bar" class="bg-gray-900 text-white py-2 transition-all duration-300">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between text-sm">
      <!-- Contact Info - Desktop Only -->
      <div class="hidden md:flex items-center space-x-6">
        <a href="tel:+35319636050" class="flex items-center hover:text-amber-400 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          +353 1 963 6050
        </a>
        <a href="mailto:info@septimiusproperties.com" class="flex items-center hover:text-amber-400 transition-colors">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          info@septimiusproperties.com
        </a>
      </div>

      <!-- Social Media Icons -->
      <div class="flex items-center space-x-3 ml-auto">
        <a href="https://www.instagram.com/septimiusproperties/" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors" aria-label="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Main Header (Sticky) -->
<header class="bg-white shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 hover:opacity-80 transition-opacity">
        <img 
          src="/Images/SP - Logo.svg" 
          alt="Septimius Properties Logo" 
          class="h-16 md:h-20 w-auto"
        />
      </a>

      <!-- Desktop Navigation - Centered -->
      <nav class="hidden md:flex absolute left-1/2 transform -translate-x-1/2 space-x-8">
        <a href="/" class="text-gray-700 hover:text-amber-500 font-medium transition-colors">Home</a>
        <a href="/about" class="text-gray-700 hover:text-amber-500 font-medium transition-colors">About</a>
        <a href="/services" class="text-gray-700 hover:text-amber-500 font-medium transition-colors">Services</a>
        <a href="/projects" class="text-gray-700 hover:text-amber-500 font-medium transition-colors">Projects</a>
        <a href="/contact" class="text-gray-700 hover:text-amber-500 font-medium transition-colors">Contact</a>
      </nav>

      <!-- Get in Touch Button - Desktop -->
      <div class="hidden md:flex items-center space-x-4">
        <a href="/projects/sheelin-lakehouse" class="border-2 border-amber-500 text-amber-500 px-6 py-2.5 text-sm font-bold hover:bg-amber-500 hover:text-white transition-colors uppercase tracking-wide rounded">
          Book Stay
        </a>
        <a href="/contact" class="border-2 border-amber-500 text-amber-500 px-6 py-2.5 text-sm font-bold hover:bg-amber-500 hover:text-white transition-colors uppercase tracking-wide rounded">
          Get in Touch
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-button" class="md:hidden text-gray-700 hover:text-amber-500 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <nav id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col space-y-3">
        <a href="/" class="text-gray-700 hover:text-amber-500 font-medium transition-colors py-2 border-b border-gray-200">Home</a>
        <a href="/about" class="text-gray-700 hover:text-amber-500 font-medium transition-colors py-2 border-b border-gray-200">About</a>
        <a href="/services" class="text-gray-700 hover:text-amber-500 font-medium transition-colors py-2 border-b border-gray-200">Services</a>
        <a href="/projects" class="text-gray-700 hover:text-amber-500 font-medium transition-colors py-2 border-b border-gray-200">Projects</a>
        <a href="/contact" class="text-gray-700 hover:text-amber-500 font-medium transition-colors py-2 border-b border-gray-200">Contact</a>
        <a href="/contact" class="border-2 border-amber-500 text-amber-500 px-6 py-2.5 text-sm font-bold hover:bg-amber-500 hover:text-white transition-colors uppercase tracking-wide rounded text-center mt-2">
          Get in Touch
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  // Initialize menu functionality
  function initMenu() {
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (!menuButton || !mobileMenu) return;

    // Remove existing listeners to prevent duplicates
    const newMenuButton = menuButton.cloneNode(true);
    menuButton.parentNode?.replaceChild(newMenuButton, menuButton);

    // Mobile menu toggle
    newMenuButton.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileMenu.classList.toggle('hidden');
    });

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!newMenuButton.contains(e.target) && !mobileMenu.contains(e.target)) {
        mobileMenu.classList.add('hidden');
      }
    });
  }

  // Initialize scroll functionality
  function initScroll() {
    const topBar = document.getElementById('top-bar');
    if (!topBar) return;

    window.addEventListener('scroll', () => {
      const currentScroll = window.pageYOffset;
      
      if (currentScroll > 50) {
        topBar.classList.add('hidden');
      } else {
        topBar.classList.remove('hidden');
      }
    });
  }

  // Run on initial page load
  initMenu();
  initScroll();

  // Run after view transitions
  document.addEventListener('astro:page-load', () => {
    initMenu();
    initScroll();
  });
</script>